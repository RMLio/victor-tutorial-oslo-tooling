<http://example.com/geslacht/man> a skos:Concept .

<http://example.com/geslacht/vrouw> a skos:Concept .

<http://example.com/orgtype/lokaal> a skos:Concept .

<http://example.com/vzw_test> a <http://www.w3.org/ns/org#Organization>;
  dc:description "Test-vereniging"@nl;
  skos:prefLabel "VZW Test"@nl;
  <http://www.w3.org/ns/org#hasSubOrganization> <http://example.com/vzw_test/onthaal>;
  <http://www.w3.org/ns/regorg#orgType> <http://example.com/orgtype/lokaal>;
  foaf:homepage "https://www.vzwtest.be" .

<http://example.com/vzw_test/onthaal> a <http://www.w3.org/ns/org#Organization>;
  dc:description "Het onthaal"@nl;
  skos:prefLabel "VZW Test onthaal"@nl;
  <http://www.w3.org/ns/regorg#orgType> <http://example.com/orgtype/lokaal>;
  foaf:homepage "https://www.vzwtest.be/onthaal" .

<http://example.com/vzw_test/persoon/001> a dc:Agent, <http://www.w3.org/ns/person#Person>;
  <http://www.w3.org/ns/org#memberOf> <http://example.com/vzw_test/onthaal>;
  <http://www.w3.org/ns/org#reportsTo> <http://example.com/vzw_test/persoon/002>;
  foaf:familyName "Peeters";
  foaf:givenName "Jan";
  <https://data.vlaanderen.be/ns/persoon#geslacht> <http://example.com/geslacht/man>;
  <https://data.vlaanderen.be/ns/persoon#volledigeNaam> "Jan Jef Peeters" .

<http://example.com/vzw_test/persoon/002> a dc:Agent, <http://www.w3.org/ns/person#Person>;
  <http://www.w3.org/ns/org#headOf> <http://example.com/vzw_test/onthaal>;
  <http://www.w3.org/ns/org#memberOf> <http://example.com/vzw_test>;
  foaf:familyName "Smets";
  foaf:givenName "Lydia";
  <https://data.vlaanderen.be/ns/persoon#geslacht> <http://example.com/geslacht/vrouw>;
  <https://data.vlaanderen.be/ns/persoon#volledigeNaam> "Lydia Smets" .

<http://example.com/vzw_test/persoon/003> a dc:Agent, <http://www.w3.org/ns/person#Person>;
  <http://www.w3.org/ns/org#headOf> <http://example.com/vzw_test>;
  foaf:familyName "Jansen";
  foaf:givenName "Tom";
  <https://data.vlaanderen.be/ns/persoon#geslacht> <http://example.com/geslacht/man>;
  <https://data.vlaanderen.be/ns/persoon#volledigeNaam> "Tom Jansen" .
