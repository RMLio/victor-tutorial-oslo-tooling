<http://example.com/geslacht/man> a skos:Concept .

<http://example.com/inagro_vzw> a <http://www.w3.org/ns/org#Organization>;
  dc:description "Onderzoekscentrum voor Land- en Tuinbouw"@nl;
  skos:prefLabel "Inagro vzw"@nl;
  <http://www.w3.org/ns/regorg#orgType> <http://example.com/orgtype/overheid>;
  foaf:homepage "https://www.inagro.be" .

<http://example.com/inagro_vzw/it> a <http://www.w3.org/ns/org#Organization> .

<http://example.com/inagro_vzw/persoon/001> a dc:Agent, <http://www.w3.org/ns/person#Person>;
  <http://www.w3.org/ns/org#reportsTo> <http://example.com/inagro_vzw/persoon/002>;
  foaf:familyName "Vanhee";
  foaf:givenName "Pieter";
  <https://data.vlaanderen.be/ns/persoon#geslacht> <http://example.com/geslacht/man>;
  <https://data.vlaanderen.be/ns/persoon#volledigeNaam> "Vanhee Pieter" .

<http://example.com/inagro_vzw/persoon/002> a dc:Agent, <http://www.w3.org/ns/person#Person>;
  <http://www.w3.org/ns/org#headOf> <http://example.com/inagro_vzw>;
  <http://www.w3.org/ns/org#memberOf> <http://example.com/inagro_vzw/it>;
  foaf:familyName "Doe";
  foaf:givenName "John";
  <https://data.vlaanderen.be/ns/persoon#geslacht> <http://example.com/geslacht/man>;
  <https://data.vlaanderen.be/ns/persoon#volledigeNaam> "Doe John" .

<http://example.com/orgtype/overheid> a skos:Concept .
