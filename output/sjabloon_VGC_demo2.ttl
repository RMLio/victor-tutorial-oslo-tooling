<http://example.com/VGC> a <http://www.w3.org/ns/org#Organization>;
  dc:description "De Vlaamse Gemeenschapscommissie bouwt aan een netwerk van Nederlandstalige gemeenschapsvoorzieningen, N-Brussel, in een meertalig en divers Brussel."@nl;
  <http://www.w3.org/ns/org#hasSubOrganization> <http://example.com/VGC/IT>, <http://example.com/VGC/SB>;
  foaf:homepage "https://www.vgc.be/" .

<http://example.com/VGC/IT> a <http://www.w3.org/ns/org#Organization>;
  dc:description "De dienst IT"@nl .

<http://example.com/VGC/SB> a <http://www.w3.org/ns/org#Organization>;
  dc:description "De cel Stedelijk Beleid"@nl .

<http://example.com/VGC/persoon/001> a dc:Agent, <http://www.w3.org/ns/person#Person>;
  <http://www.w3.org/ns/org#memberOf> <http://example.com/VGC/IT>;
  foaf:familyName "Fostier";
  foaf:givenName "Kristof";
  <https://data.vlaanderen.be/ns/persoon#geslacht> <http://example.com/geslacht/man>;
  <https://data.vlaanderen.be/ns/persoon#volledigeNaam> "Kristof Fostier" .

<http://example.com/VGC/persoon/002> a dc:Agent, <http://www.w3.org/ns/person#Person>;
  <http://www.w3.org/ns/org#memberOf> <http://example.com/VGC/SB>;
  foaf:familyName "Van den Bergh";
  foaf:givenName "Nathan";
  <https://data.vlaanderen.be/ns/persoon#geslacht> <http://example.com/geslacht/man>;
  <https://data.vlaanderen.be/ns/persoon#volledigeNaam> "Nathan Van den Bergh" .

<http://example.com/VGC/persoon/003> a dc:Agent, <http://www.w3.org/ns/person#Person>;
  <http://www.w3.org/ns/org#memberOf> <http://example.com/VGC/IT>;
  foaf:familyName "Raeymakers";
