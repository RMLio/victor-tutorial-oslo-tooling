<http://example.com/gemeente_Tervuren> a <http://www.w3.org/ns/org#Organization>;
  dc:description "Overkoepelende organisatie voor Tervuren"@nl;
  <http://www.w3.org/ns/org#hasSubOrganization> <http://example.com/orgtype/overheid>;
  <http://www.w3.org/ns/regorg#orgType> <http://example.com/orgtype/lokaal>;
  foaf:homepage "https://tervuren.be" .

<http://example.com/gemeente_Tervuren/burgerzaken> a <http://www.w3.org/ns/org#Organization>;
  dc:description "dienst burgerzaken tervuren"@nl;
  <http://www.w3.org/ns/regorg#orgType> <http://example.com/orgtype/lokaal>;
  foaf:homepage "https://tervuren.be/burgerzaken" .

<http://example.com/gemeente_Tervuren/persoon/001> a dc:Agent, <http://www.w3.org/ns/person#Person>;
  <http://www.w3.org/ns/org#memberOf> <http://example.com/gemeente_Tervuren/burgerzaken>;
  <http://www.w3.org/ns/org#reportsTo> <http://example.com/gemeente_Tervuren/persoon/002>;
  foaf:familyName "Brockx";
  foaf:givenName "Bert";
  <https://data.vlaanderen.be/ns/persoon#geslacht> <http://example.com/geslacht/man>;
  <https://data.vlaanderen.be/ns/persoon#volledigeNaam> "Bert Brocx" .

<http://example.com/gemeente_Tervuren/persoon/002> a dc:Agent, <http://www.w3.org/ns/person#Person>;
  <http://www.w3.org/ns/org#headOf> <http://example.com/gemeente_Tervuren/burgerzaken>;
  <http://www.w3.org/ns/org#memberOf> <http://example.com/gemeente_Tervuren/burgerzaken>;
  foaf:familyName "Brockx";
  foaf:givenName "Jan";
  <https://data.vlaanderen.be/ns/persoon#geslacht> <http://example.com/geslacht/man>;
  <https://data.vlaanderen.be/ns/persoon#volledigeNaam> "Jan Brockx" .

<http://example.com/geslacht/man> a skos:Concept .

<http://example.com/orgtype/lokaal> a skos:Concept .

